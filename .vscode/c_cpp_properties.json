{
  "configurations": [
    {
      "name": "Wearable ESP32-S3",
      "compileCommands": "${workspaceFolder}/firmware/wearable/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/firmware/wearable/build/lib/**",
        "${userHome}/.platformio/packages/framework-arduinoespressif32/**"
      ],
      "defines": [
        "ARDUINO=10812",
        "ARDUINO_ARCH_ESP32",
        "ARDUINO_USB_MODE=1",
        "ARDUINO_USB_CDC_ON_BOOT=1"
      ],
      "cppStandard": "gnu++11"
    }
  ],
  "version": 4
}
