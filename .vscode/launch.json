{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "USB bridge: Wearable → Robot (motors enabled)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/wearable/bridge.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--wearable-port",
        "/dev/cu.usbmodem11301",
        "--robot-port",
        "/dev/cu.usbmodem101"
      ],
      "justMyCode": true
    },
    {
      "name": "USB bridge: Wearable monitor (motors disabled)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/wearable/bridge.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--wearable-port",
        "/dev/cu.usbmodem11301",
        "--robot-port",
        "/dev/cu.usbmodem101",
        "--monitor-only"
      ],
      "justMyCode": true
    }
  ]
}
